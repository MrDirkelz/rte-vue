{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "declaration": true,
        "emitDeclarationOnly": false,
        "outDir": "dist",
        "jsx": "preserve",
        "types": ["vue", "vitest/globals"],
        "lib": ["ES2020", "DOM"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.vue",
        "tests/**/*.ts"
    ]
}
